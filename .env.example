# 火山引擎豆包语音合成大模型（与 coolbot 环境变量完全兼容，可直接复用）
# 复制本文件为 .env 并填入你的凭据（.env 已在 .gitignore 中，切勿提交密钥）

# 新版语音控制台推荐使用单个 API Key：
VOLCENGINE_TTS_API_KEY=

# 若使用旧版控制台，请改为填写以下两项（同时留空上面的 API Key）：
# VOLCENGINE_TTS_APP_ID=
# VOLCENGINE_TTS_ACCESS_KEY=

# 服务地址（默认 v3 单向流式 HTTP Chunked 接口）
VOLCENGINE_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional

# 模型资源 ID（2.0 内置音色用 seed-tts-2.0；1.0 用 seed-tts-1.0；声音复刻用 seed-icl-2.0）
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0

# 默认口播音色（与 coolbot 主讲对齐：云舟 2.0）
# 常用 2.0 内置音色：
#   zh_male_m191_uranus_bigtts             云舟 2.0（自然口语，推荐主讲）
#   zh_male_jieshuoxiaoming_uranus_bigtts  解说小明 2.0（短视频解说）
#   zh_male_dayi_uranus_bigtts             大壹 2.0（轻松吐槽）
#   zh_male_fanjuanqingnian_uranus_bigtts  反卷青年 2.0（松弛吐槽）
#   zh_female_vv_uranus_bigtts             Vivi 2.0（清新女声）
VOLCENGINE_TTS_VOICE=zh_male_m191_uranus_bigtts

# 可选参数：语速/音量范围 -50..100，采样率支持 8000/16000/22050/24000/32000/44100/48000
VOLCENGINE_TTS_SPEECH_RATE=0
VOLCENGINE_TTS_LOUDNESS_RATE=0
VOLCENGINE_TTS_SAMPLE_RATE=24000

# 可选：仅 seed-tts-2.0 支持的语气上下文指令，例如：语气轻松自然，像老钓友闲聊
# VOLCENGINE_TTS_CONTEXT_TEXT=
# VOLCENGINE_TTS_UID=castcut-user
